<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Set TargetFramework and RevitInstallDir for the exact Revit release. -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Goodday.AutodeskSmoke.Revit</AssemblyName>
    <RootNamespace>Goodday.AutodeskSmoke.Revit</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
